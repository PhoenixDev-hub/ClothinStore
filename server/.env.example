DATABASE_URL="postgresql://loja:loja123@localhost:5432/loja_roupas?schema=public"
# Used by `prisma migrate` (must be a direct, non-pooled connection)
DIRECT_URL="postgresql://loja:loja123@localhost:5432/loja_roupas?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
PORT=3001

# development | test | production. Em production o Swagger é desativado.
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Origens permitidas no CORS, separadas por vírgula.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Protege POST/PUT/DELETE de produtos e categorias (header x-api-key). Mínimo 32 caracteres.
ADMIN_API_KEY="troque-por-uma-chave-aleatoria-com-32-caracteres-ou-mais"
# Somente dígitos, com DDI (ex.: 5585999999999).
WHATSAPP_NUMBER=5585999999999

# Necessárias para o upload de imagens (Supabase Storage)
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"
